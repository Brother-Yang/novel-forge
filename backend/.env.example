# LLM 提供方:ollama(本地) | bailian(阿里云百炼) | openai(OpenAI 兼容)
LLM_PROVIDER=ollama

# --- Ollama 本地模型 ---
OLLAMA_BASE_URL=http://localhost:11434
GENERATION_MODEL=qwen2.5:14b
EMBEDDING_MODEL=qwen3-embedding:latest

# --- 阿里云百炼(DashScope):把 LLM_PROVIDER 改为 bailian 并填入 API Key ---
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
BAILIAN_GENERATION_MODEL=qwen-plus
BAILIAN_EMBEDDING_MODEL=text-embedding-v3

# --- 其它 OpenAI 兼容 API(把 LLM_PROVIDER 改为 openai) ---
OPENAI_BASE_URL=
OPENAI_API_KEY=

# 数据库与向量库
DATABASE_URL=sqlite:///./data/novel.db
CHROMA_DIR=./data/chroma

# 允许跨域访问的前端地址,逗号分隔;生产部署改成实际域名(不要用 *)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 生成上下文 token 预算(粗略字符估算)
CONTEXT_TOKEN_BUDGET=6000
PREVIOUS_SUMMARY_COUNT=6

# 智能体自主决策模式安全上限(仅 openai/bailian 后端支持;超限自动强制收尾)
AGENT_MAX_STEPS=40
AGENT_MAX_TOOL_CALLS=60
AGENT_MAX_REWRITES=2

# LLM 调用失败(超时/限流/5xx)时的重试次数与首次重试延迟秒数(指数退避)
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_BASE_DELAY=1.0
