# LLM 提供方：ollama（默认本地）、bailian 或 dashscope（阿里云百炼）、openai（兼容 API）。
LLM_PROVIDER=ollama

# --- Ollama 本地模型 ---
OLLAMA_BASE_URL=http://localhost:11434
GENERATION_MODEL=qwen2.5:14b
EMBEDDING_MODEL=qwen3-embedding:latest

# --- 阿里云百炼(DashScope):把 LLM_PROVIDER 改为 bailian 并填入 API Key ---
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
BAILIAN_GENERATION_MODEL=qwen-plus
BAILIAN_EMBEDDING_MODEL=text-embedding-v3

# --- 其它 OpenAI 兼容 API(把 LLM_PROVIDER 改为 openai) ---
OPENAI_BASE_URL=
OPENAI_API_KEY=

# 数据库与向量库
DATABASE_URL=sqlite:///./data/novel.db
CHROMA_DIR=./data/chroma

# 本机开发用 local；对外提供服务时改为 production 并启用 HTTPS。
APP_ENV=local
# 生产必须设置独立的随机访问密码（至少 12 个字符）和会话密钥（至少 32 字节）。
ACCESS_PASSWORD=
SESSION_SECRET=
SESSION_TTL_SECONDS=43200
LOGIN_ATTEMPTS_PER_WINDOW=5
LOGIN_WINDOW_SECONDS=300

# 允许跨域访问的前端来源，逗号分隔；生产填写明确的 HTTPS 来源（不要用 *）。
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 全站生成/重试/记忆修复请求限频与同时生成的书籍上限。
GENERATION_REQUESTS_PER_WINDOW=30
GENERATION_WINDOW_SECONDS=3600
GENERATION_MAX_CONCURRENT=2
# 所有实际模型请求（含摘要、嵌入、重试）共享此窗口。
LLM_REQUESTS_PER_WINDOW=600
LLM_WINDOW_SECONDS=3600
# 模型 HTTP 超时秒数。读超时是等待下一批响应数据的时间，不是整章时限。
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_READ_TIMEOUT_SECONDS=180
LLM_WRITE_TIMEOUT_SECONDS=30
LLM_POOL_TIMEOUT_SECONDS=10

# 生成上下文 token 预算(粗略字符估算)
CONTEXT_TOKEN_BUDGET=6000
PREVIOUS_SUMMARY_COUNT=6

# 智能体自主决策模式安全上限(仅 openai/bailian 后端支持;超限标记错误,可重试继续)
AGENT_MAX_STEPS=40
AGENT_MAX_TOOL_CALLS=60
AGENT_MAX_REWRITES=2

# 调用总尝试次数包含首次请求，至少为 1。首次重试延迟为 0 时立即重试。
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_BASE_DELAY=1.0
